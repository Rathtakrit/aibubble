---
import "@fontsource/instrument-serif/400.css";
import "@fontsource-variable/instrument-sans/index.css";
import "../styles/tokens.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AI Bubble</title>
  </head>
  <body>
    <div style="padding: 16px;">
      <h1>AI Bubble</h1>
      <p>The site is being built.</p>
      <ul>
        <li><span class="swatch" style="background: var(--paper);"></span> --paper</li>
        <li><span class="swatch" style="background: var(--ink);"></span> --ink</li>
        <li><span class="swatch" style="background: var(--ink-2);"></span> --ink-2</li>
        <li><span class="swatch" style="background: var(--rule);"></span> --rule</li>
        <li><span class="swatch" style="background: var(--accent);"></span> --accent</li>
        <li><span class="swatch" style="background: var(--investment);"></span> --investment</li>
        <li><span class="swatch" style="background: var(--cloud);"></span> --cloud</li>
        <li><span class="swatch" style="background: var(--chip);"></span> --chip</li>
      </ul>
    </div>
  </body>
</html>

<style>
  .swatch {
    display: inline-block;
    width: 16px;
    height: 16px;
    border: 1px solid var(--ink);
    vertical-align: middle;
    margin-right: 8px;
  }
</style>
