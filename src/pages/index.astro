---
import "@fontsource/instrument-serif/400.css";
import "@fontsource-variable/instrument-sans/index.css";
import "../styles/tokens.css";
import { status } from "../lib/data.ts";
import { defaultDate, formatDate, formatValue, totalForDate } from "../lib/layout.ts";

const date = defaultDate();
const total = totalForDate(date);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AI Bubble</title>
  </head>
  <body>
    <main style="padding: 16px;">
      <h1>AI Bubble</h1>
      <p id="bubble-line">All AI companies on {formatDate(date)} · total {formatValue(total)}</p>
      <div style="position: relative;">
        <svg
          id="bubble"
          viewBox="0 0 100 100"
          role="img"
          style="display: block; width: 100%; max-width: 680px; height: auto; aspect-ratio: 1 / 1;"
        ></svg>
        <div
          style="position: absolute; right: 0; bottom: 6%; display: flex; flex-direction: column; background: var(--paper); border: 1px solid var(--ink);"
        >
          <button
            type="button"
            id="zoom-in"
            aria-label="Zoom in"
            style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; border: none; background: transparent; color: var(--ink); cursor: pointer;"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M12 5v14"></path>
            </svg>
          </button>
          <button
            type="button"
            id="zoom-out"
            aria-label="Zoom out"
            style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; border: none; border-top: 1px solid var(--rule); background: transparent; color: var(--ink); cursor: pointer;"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M5 12h14"></path>
            </svg>
          </button>
          <button
            type="button"
            id="zoom-fit"
            aria-label="Fit the view to the players"
            style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; border: none; border-top: 1px solid var(--rule); background: transparent; color: var(--ink); cursor: pointer;"
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path>
            </svg>
          </button>
        </div>
      </div>
      {
        status !== "approved" && (
          <p>{status === "sample" ? "Sample data, for testing only." : "Draft data: researched, not yet checked by the owner."}</p>
        )
      }
    </main>
    <script>
      import { renderBubble } from "../lib/bubble.ts";
      import { ZOOMS } from "../lib/camera.ts";
      import { defaultDate, formatDate, formatValue, totalForDate } from "../lib/layout.ts";

      const params = new URLSearchParams(window.location.search);
      const requested = params.get("date");
      const date = requested && /^\d{4}-\d{2}-\d{2}$/.test(requested) ? requested : defaultDate();
      // The players of the current item: the companies the camera flies to.
      const players = (params.get("players") ?? "")
        .split(",")
        .map((id) => id.trim())
        .filter((id) => id.length > 0);

      // The reader's own zoom on top of the automatic camera; index 1 = follow the players exactly.
      let zoomIndex = 1;

      const svg = document.querySelector<SVGSVGElement>("#bubble");
      const zoomIn = document.querySelector<HTMLButtonElement>("#zoom-in");
      const zoomOut = document.querySelector<HTMLButtonElement>("#zoom-out");
      const zoomFit = document.querySelector<HTMLButtonElement>("#zoom-fit");

      function draw(): void {
        if (svg) renderBubble(svg, date, { players, manual: ZOOMS[zoomIndex] });
        if (zoomIn) zoomIn.disabled = zoomIndex === ZOOMS.length - 1;
        if (zoomOut) zoomOut.disabled = zoomIndex === 0;
      }

      zoomIn?.addEventListener("click", () => {
        zoomIndex = Math.min(ZOOMS.length - 1, zoomIndex + 1);
        draw();
      });
      zoomOut?.addEventListener("click", () => {
        zoomIndex = Math.max(0, zoomIndex - 1);
        draw();
      });
      zoomFit?.addEventListener("click", () => {
        zoomIndex = 1;
        draw();
      });

      draw();

      const line = document.querySelector("#bubble-line");
      if (line) {
        line.textContent = `All AI companies on ${formatDate(date)} · total ${formatValue(totalForDate(date))}`;
      }
    </script>
  </body>
</html>

<style is:global>
  .bubble {
    transition: opacity 700ms ease;
  }
  .bubble-circle {
    transition: r 700ms ease;
  }
  .bubble-arrow {
    transition: opacity 700ms ease;
  }
  button:disabled {
    opacity: 0.35;
    cursor: default;
  }
  @media (prefers-reduced-motion: reduce) {
    .bubble,
    .bubble-circle,
    .bubble-arrow {
      transition: none;
    }
  }
</style>
