---
import "@fontsource/instrument-serif/400.css";
import "@fontsource-variable/instrument-sans/index.css";
import "../styles/tokens.css";
import "../styles/explore.css";
import { companies, deals, news, status } from "../lib/data.ts";
import { defaultDate, formatValue, totalForDate } from "../lib/layout.ts";
import {
  dayIndex,
  dayLabel,
  dayPercent,
  FIRST_DAY,
  inDateOrder,
  PILL_LABELS,
  pillKind,
  placeLabels,
  publisherName,
} from "../lib/timeline.ts";

// The page is drawn here in its first state and then follows the visitor with explore.ts.
const lastDate = defaultDate();
// Explore walks money news only, from the ChatGPT launch on; the other news waits for its own tab.
const ordered = inDateOrder(news.filter((item) => item.kind === "money" && item.date >= FIRST_DAY));
const current = ordered[ordered.length - 1];
const count = ordered.length;
const position = count;
const pill = pillKind(current, deals);
const nameOf = new Map(companies.map((company) => [company.id, company.name]));
const players = current.players.map((id) => nameOf.get(id) ?? id).join(", ");
const keyDates = ordered.filter((item) => item.key_date);
const place = new Map(ordered.map((item, index) => [item.id, index + 1]));
const lastDay = dayIndex(lastDate);
const publisher = publisherName(current.source);

// A day tick under the line: every 1 January carries its year, the quarter days carry nothing.
const ticks: { date: string; year: boolean }[] = [];
for (let year = Number(FIRST_DAY.slice(0, 4)); year <= Number(lastDate.slice(0, 4)); year += 1) {
  for (const month of ["01", "04", "07", "10"]) {
    const date = `${year}-${month}-01`;
    if (date < FIRST_DAY || date > lastDate) continue;
    ticks.push({ date, year: month === "01" });
  }
}

// Above the line: the first 16 characters of a key date's title, then an ellipsis.
const labelOf = (title: string) =>
  title.length > 16 ? `${title.slice(0, 16).trimEnd()}…` : title;

// Which of the two label heights each title takes, so neighbours do not overlap. The page draws
// them from this first estimate; explore.ts re-places them once the real widths are known.
const labels = placeLabels(
  keyDates.map((item) => ({
    id: item.id,
    percent: dayPercent(item.date, lastDate),
    width: labelOf(item.title).length * 6.4,
  })),
  1280,
);

const statusLine =
  status === "sample"
    ? "Sample data, for testing only."
    : status === "draft"
      ? "Draft data: researched, not yet checked by the owner."
      : "";
const ariaFor = (id: string, title: string, date: string) =>
  `News ${place.get(id)} of ${count}: ${dayLabel(date)}, ${title}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AI Bubble</title>
  </head>
  <body>
    <div class="layout-desktop">
      <header class="site-header">
        <a class="wordmark" href="/">AI Bubble</a>
        <nav class="site-nav" aria-label="Sections">
          <a class="nav-item nav-current" href="/" aria-current="page">Explore</a>
          <span class="nav-item">Science<span class="nav-tag">soon</span></span>
          <span class="nav-item">News<span class="nav-tag">soon</span></span>
          <span class="nav-item">Past bubbles<span class="nav-tag">soon</span></span>
        </nav>
      </header>

      <main class="explore-main">
        <div class="story-column">
          <p class="kicker" data-bind="kicker-desktop">Explore · news {position} of {count}</p>
          <p class="big-date" data-bind="date">{dayLabel(current.date)}</p>

          <div data-block="item">
            <span class:list={["pill", `pill-${pill}`]} data-bind="pill"
              ><span class="pill-line" aria-hidden="true"></span
              ><span data-bind="pill-label">{PILL_LABELS[pill]}</span></span
            >
            <h1 class="headline" data-bind="title">{current.title}</h1>
            <p class="summary" data-bind="summary">{current.summary}</p>
            <a
              class="source"
              data-bind="source"
              href={current.source}
              target="_blank"
              rel="noopener"
              aria-label={`Source: ${publisher}, opens in a new tab`}
              >{publisher} · {dayLabel(current.date)} ↗</a
            >
            <p class="players-line" data-players-line>
              The view follows the players:{" "}
              <strong data-bind="names-desktop">{players}</strong>
            </p>
          </div>

          <div data-block="quiet" hidden>
            <p class="latest-label">Latest before this day:</p>
            <button type="button" class="latest-button" data-action="latest" data-bind="latest-title"
              >{current.title}</button
            >
          </div>

          <div data-block="company" hidden>
            <button type="button" class="company-back" data-action="company-back">← Back</button>
            <h1 class="headline" data-bind="company-name"></h1>
            <p class="company-value" data-bind="company-value"></p>
            <p class="company-note" data-bind="company-note"></p>
            <a class="source" data-bind="company-source" target="_blank" rel="noopener"></a>
            <p class="sheet-kicker company-news-heading">News</p>
            <ul class="company-news" data-bind="company-news"></ul>
            <p class="company-news-empty" data-bind="company-news-empty" hidden
              >No news about this company up to this day.</p
            >
          </div>

          <div class="button-row">
            <button type="button" class="button" data-action="earlier">← Earlier</button>
            <button type="button" class="button button-primary" data-action="later">Later →</button>
          </div>
        </div>

        <div class="bubble-column">
          <div class="bubble-wrap">
            <svg class="bubble-svg" data-bubble="desktop" viewBox="0 0 100 100" role="img"></svg>
            <div class="zoom-buttons">
              <button type="button" class="zoom-button" data-zoom="in" aria-label="Zoom in">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5v14"></path></svg>
              </button>
              <button type="button" class="zoom-button" data-zoom="out" aria-label="Zoom out">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"></path></svg>
              </button>
              <button type="button" class="zoom-button" data-zoom="fit" aria-label="Fit the view to the players">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg>
              </button>
            </div>
          </div>
          <div class="bubble-meta">
            <span data-bind="companies"
              >All AI companies on {dayLabel(current.date)} · total {formatValue(totalForDate(current.date))}</span
            >
          </div>
          <div class="legend">
            <span class="legend-title">Money flow</span>
            <span class="legend-item"><span class="legend-line legend-investment" aria-hidden="true"></span>Investment</span>
            <span class="legend-item"><span class="legend-line legend-cloud" aria-hidden="true"></span>Cloud deal</span>
            <span class="legend-item"><span class="legend-line legend-chip" aria-hidden="true"></span>Chip deal</span>
          </div>
        </div>
      </main>

      <section class="timeline" aria-label="Timeline">
        <div class="timeline-inner" data-timeline>
          <div class="timeline-axis" aria-hidden="true"></div>
          <input
            class="day-range"
            data-slider
            type="range"
            min="0"
            max={lastDay}
            step="1"
            value={dayIndex(current.date)}
            aria-label="Day"
          />
          {
            keyDates.map((item) => {
              const left = dayPercent(item.date, lastDate);
              const label = labels.get(item.id);
              return (
                <>
                  <button
                    type="button"
                    class="timeline-dot"
                    data-news={item.id}
                    style={`left: ${left}%`}
                    aria-label={ariaFor(item.id, item.title, item.date)}
                  >
                    <span class:list={["dot", `dot-${pillKind(item, deals)}`]} />
                  </button>
                  <span
                    class="timeline-label"
                    data-timeline-label
                    data-row={label?.row}
                    data-align={label?.align ?? "center"}
                    style={`left: ${left}%`}
                    hidden={!label}
                    aria-hidden="true"
                  >
                    {labelOf(item.title)}
                  </span>
                </>
              );
            })
          }
          {
            ticks.map((tick) => (
              <span
                class:list={["timeline-tick", `timeline-tick-${tick.year ? "year" : "quarter"}`]}
                style={`left: ${dayPercent(tick.date, lastDate)}%`}
                aria-hidden="true"
              />
            ))
          }
          {
            ticks
              .filter((tick) => tick.year)
              .map((tick) => (
                <span class="timeline-year" style={`left: ${dayPercent(tick.date, lastDate)}%`} aria-hidden="true">
                  {tick.date.slice(0, 4)}
                </span>
              ))
          }
          <div class="timeline-ends" aria-hidden="true"><span>Nov 2022</span><span>Today</span></div>
        </div>

        {statusLine && <p class="status">{statusLine}</p>}
      </section>
    </div>

    <div class="layout-phone">
      <div class="map-bubble">
        <svg class="bubble-svg" data-bubble="phone" viewBox="0 0 100 100" role="img"></svg>
      </div>

      <div class="map-top">
        <span class="wordmark-chip">AI Bubble</span>
      </div>

      <div class="zoom-buttons map-zoom">
        <button type="button" class="zoom-button" data-zoom="in" aria-label="Zoom in">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5v14"></path></svg>
        </button>
        <button type="button" class="zoom-button" data-zoom="out" aria-label="Zoom out">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"></path></svg>
        </button>
        <button type="button" class="zoom-button" data-zoom="fit" aria-label="Fit the view to the players">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg>
        </button>
      </div>

      <section class="sheet" aria-label="News item">
        <div class="grabber" aria-hidden="true"></div>
        <p class="sheet-kicker" data-bind="kicker-phone">
          News {position} of {count} · {dayLabel(current.date)}
        </p>

        <div data-block="item">
          <h1 class="sheet-title" data-bind="title">{current.title}</h1>
          <p class="summary" data-bind="summary">{current.summary}</p>
          <a
            class="source"
            data-bind="source"
            href={current.source}
            target="_blank"
            rel="noopener"
            aria-label={`Source: ${publisher}, opens in a new tab`}
            >{publisher} · {dayLabel(current.date)} ↗</a
          >
          <div class="pill-row">
            <span class:list={["pill", `pill-${pill}`]} data-bind="pill"
              ><span class="pill-line" aria-hidden="true"></span
              ><span data-bind="pill-label">{PILL_LABELS[pill]}</span></span
            >
            <span class="players-line" data-players-line>
              Players: <strong data-bind="names-phone">{players}</strong>
            </span>
          </div>
        </div>

        <div data-block="quiet" hidden>
          <p class="latest-label">Latest before this day:</p>
          <button type="button" class="latest-button" data-action="latest" data-bind="latest-title"
            >{current.title}</button
          >
        </div>

        <div data-block="company" hidden>
          <button type="button" class="company-back" data-action="company-back">← Back</button>
          <h1 class="sheet-title" data-bind="company-name"></h1>
          <p class="company-value" data-bind="company-value"></p>
          <p class="company-note" data-bind="company-note"></p>
          <a class="source" data-bind="company-source" target="_blank" rel="noopener"></a>
          <p class="sheet-kicker company-news-heading">News</p>
          <ul class="company-news" data-bind="company-news"></ul>
          <p class="company-news-empty" data-bind="company-news-empty" hidden
            >No news about this company up to this day.</p
          >
        </div>

        <div class="legend">
          <span class="legend-item"><span class="legend-line legend-investment" aria-hidden="true"></span>Investment</span>
          <span class="legend-item"><span class="legend-line legend-cloud" aria-hidden="true"></span>Cloud</span>
          <span class="legend-item"><span class="legend-line legend-chip" aria-hidden="true"></span>Chips</span>
        </div>

        <div class="sheet-timeline">
          <div class="timeline-axis" aria-hidden="true"></div>
          <input
            class="day-range"
            data-slider
            type="range"
            min="0"
            max={lastDay}
            step="1"
            value={dayIndex(current.date)}
            aria-label="Day"
          />
          {
            keyDates.map((item) => (
              <button
                type="button"
                class="timeline-dot"
                data-news={item.id}
                style={`left: ${dayPercent(item.date, lastDate)}%`}
                aria-label={ariaFor(item.id, item.title, item.date)}
              >
                <span class:list={["dot", `dot-${pillKind(item, deals)}`]} />
              </button>
            ))
          }
        </div>
        <div class="timeline-ends" aria-hidden="true"><span>Nov 2022</span><span>Today</span></div>

        <div class="sheet-buttons">
          <button type="button" class="button" data-action="earlier">← Earlier</button>
          <button type="button" class="button button-primary" data-action="later">Later →</button>
        </div>

        {statusLine && <p class="status">{statusLine}</p>}
      </section>
    </div>

    <script>
      import "../scripts/explore.ts";
    </script>
  </body>
</html>
