---
import "@fontsource/instrument-serif/400.css";
import "@fontsource-variable/instrument-sans/index.css";
import "../styles/tokens.css";
import "../styles/compare.css";
import { SITE_NAME } from "../lib/site.ts";
const pageTitle = `Page not found | ${SITE_NAME}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="compare-page">
      <header class="site-header">
        <a class="wordmark" href="/">Bubble</a>
        <nav class="site-nav mode-switch" aria-label="Sections">
          <a class="nav-item mode-button" href="/">AI</a>
          <a class="nav-item mode-button" href="/past/dotcom/">Dot-com</a>
          <a class="nav-item mode-button" href="/past/housing/">Housing</a>
          <a class="nav-item mode-button" href="/compare/">Compare</a>
        </nav>
      </header>
      <main>
        <h1>Page not found</h1>
        <p>This page doesn't exist.</p>
        <div class="actions">
          <a class="nav-item nav-current" href="/">AI bubble</a>
          <a class="nav-item nav-current" href="/compare/">Compare</a>
        </div>
      </main>
    </div>
  </body>
</html>
