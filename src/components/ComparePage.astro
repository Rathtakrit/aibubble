---
import "@fontsource/instrument-serif/400.css";
import "@fontsource-variable/instrument-sans/index.css";
import "../styles/tokens.css";
import "../styles/compare.css";
import { datasets, comparisonLine, formatTotal, moments, momentOptions, packedOn, totalOn } from "../lib/compare.ts";
const names = { ai: "AI", dotcom: "Dot-com", housing: "Housing" };
const choices = { start: "Start", lowest: "Lowest recorded", peak: "Peak recorded", latest: "Latest" };
const defaults = [
  { dataset: datasets[0], moment: "lowest" as const },
  { dataset: datasets[1], moment: "peak" as const },
];
const frames = defaults.map(({ dataset, moment }) => {
  const date = moments(dataset)[moment]!;
  return { dataset, moment, date, ...totalOn(dataset, date), circles: packedOn(dataset, date) };
});
const maximum = Math.max(...frames.map((f) => f.total), 1);
const dayLabel = (date: string) => new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" }).format(new Date(`${date}T00:00:00Z`));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Compare the bubbles | AI Bubble</title>
  </head>
  <body>
    <div class="compare-page">
      <header class="site-header">
        <a class="wordmark" href="/">Bubble</a>
        <nav class="site-nav" aria-label="Sections">
          <a class="nav-item" href="/">AI</a>
          <a class="nav-item" href="/past/dotcom/">Dot-com</a>
          <a class="nav-item" href="/past/housing/">Housing</a>
          <a class="nav-item nav-current" href="/compare/" aria-current="page">Compare</a>
        </nav>
      </header>
      <main id="compare">
        <div class="heading">
          <div><h1>Compare the bubbles</h1></div>
          <div class="segments" role="group" aria-label="Measure">
            <button type="button" data-measure="size" aria-pressed="true">Size</button>
            <button type="button" data-measure="change" aria-pressed="false">Change %</button>
            <button type="button" disabled>Growth <small>soon</small></button>
          </div>
        </div>
        <div class="quick-questions" role="group" aria-label="Quick questions">
          <span>Try</span>
          <button type="button" data-quick="lowest">AI lowest vs Dot-com peak</button>
          <button type="button" data-quick="peaks">AI current vs Dot-com peak</button>
          <button type="button" data-quick="biggest">Biggest company of each</button>
          <button type="button" data-quick="then">AI then vs AI now</button>
        </div>
        <div class="workbench">
          {frames.map((frame, index) => (
            <section class={`exposure exposure-${index}`} data-side={index} aria-label={`Side ${index === 0 ? "A" : "B"}`}>
              <div class="caption"><span class="total" data-total>{formatTotal(frame.total)}</span><p data-caption>on {dayLabel(frame.date)} · {frame.values.length} companies</p></div>
              <details class="picker" open>
                <summary aria-label={`Side ${index === 0 ? "A" : "B"} pickers`}><span data-tile>{names[frame.dataset.id]} · {frame.moment}</span></summary>
                <div class="picker-fields">
                  <div class="picker-group"><span>Bubble</span><div class="segments bubble-pills" role="group" aria-label={`Exposure ${index === 0 ? "A" : "B"} bubble`}>{datasets.map((dataset) => <button type="button" data-bubble={dataset.id} aria-pressed={dataset.id === frame.dataset.id}>{names[dataset.id]}</button>)}</div></div>
                  <div class="picker-group"><span>Moment</span><div class="moment-pills" role="group" aria-label={`Exposure ${index === 0 ? "A" : "B"} moment`}>{momentOptions(frame.dataset.id).map((option) => <button type="button" data-moment={option.id} aria-pressed={option.id === frame.moment}>{option.label}</button>)}</div></div>
                </div>
              </details>
            </section>
          ))}
          <div class="drawing">
            <div class="drawing-legend" data-size-legend aria-label="Drawing sides">
              {frames.map((frame, index) => <span data-drawing-label={index}>{index === 0 ? "A" : "B"} · {names[frame.dataset.id]}, {choices[frame.moment].toLowerCase()}</span>)}
            </div>
            <svg data-size viewBox="0 0 620 500" role="img" aria-label="A in blue and B in orange, sharing one area scale and bottom point">
              {frames.map((frame, index) => {
                const r = 225 * Math.sqrt(frame.total / maximum);
                return <g data-exposure={index}>
                  <circle data-shape={`${index}-frame`} cx="300" cy={485-r} r={r} class="outline" />
                  {frame.circles.map((circle) => <circle data-shape={`${index}-${circle.company.id}`} cx={300+(circle.x-50)*r/48} cy={485-r+(circle.y-50)*r/48} r={circle.r*r/48} class="company"><title>{circle.company.name}: {formatTotal(circle.value)}</title></circle>)}
                </g>;
              })}
              <line x1="300" y1="485" x2="300" y2="495" stroke="currentColor" />
            </svg>
            <div data-change hidden>
            <svg viewBox="0 0 620 500" role="img" aria-label="Change from each bubble's Start total to its chosen moment">
              <line x1="300" y1="110" x2="300" y2="410" class="zero-line" />
              <text x="300" y="90" text-anchor="middle">0%</text>
              {[0,1].map((index) => <g data-exposure={index}><rect data-bar={index} x="300" y={160+index*140} width="0" height="48" /><text data-bar-label={index} x="300" y={145+index*140} text-anchor="middle" /></g>)}
              <text x="300" y="465" text-anchor="middle">Change from Start</text>
            </svg>
            </div>
          </div>
        </div>
        <div class="result-row">
          <p class="result" data-result aria-live="polite">{comparisonLine(frames[0].total, frames[1].total)}</p>
          <div class="actions">
            <button type="button" data-swap>Swap<span class="desktop-word"> A and B</span></button>
            <button type="button" data-open="players" aria-haspopup="dialog">Players: {frames.reduce((n, f) => n+f.values.length, 0)} of {frames.reduce((n, f) => n+f.values.length, 0)}</button>
            <button type="button" data-open="sources" aria-haspopup="dialog">Sources</button>
          </div>
        </div>
        <dialog data-dialog="players" aria-labelledby="players-title"><form method="dialog"><h2 id="players-title">Players</h2><button>Close</button></form><div class="segments player-side-switch" role="group" aria-label="Players side"><button type="button" data-player-side="0" aria-pressed="true">A</button><button type="button" data-player-side="1" aria-pressed="false">B</button></div><div data-player-groups></div></dialog>
        <dialog data-dialog="sources" aria-labelledby="sources-title"><form method="dialog"><h2 id="sources-title">Sources</h2><button>Close</button></form><div class="source-controls"><div class="segments source-side-switch" role="group" aria-label="Source side"><button type="button" data-source-side="0" aria-pressed="true">A</button><button type="button" data-source-side="1" aria-pressed="false">B</button></div><div class="segments" data-source-period-control hidden role="group" aria-label="Source moment"><button type="button" data-source-period="chosen" aria-pressed="true">Chosen</button><button type="button" data-source-period="start" aria-pressed="false">Start</button></div></div><div data-sources></div><div class="source-pagination" data-source-pagination hidden><button type="button" data-source-page="previous">Previous</button><span data-source-page-label></span><button type="button" data-source-page="next">Next</button></div><div class="foot"><p>Circle area = total value of chosen companies, on one scale. Value means what they are worth together. US dollars, not adjusted for inflation; B = billion, T = trillion.</p><p>Mostly year-end records: lowest/highest mean recorded. Records carry forward. AI Current is the latest record; AI includes private-company valuations (estimated worth of companies without publicly traded shares).</p><div data-missing></div></div></dialog>
      </main>
    </div>
    <script>import "../scripts/compare.ts";</script>
  </body>
</html>
