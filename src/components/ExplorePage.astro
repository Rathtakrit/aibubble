---
import "@fontsource/instrument-serif/400.css";
import "@fontsource-variable/instrument-sans/index.css";
import "../styles/tokens.css";
import "../styles/explore.css";
import {
  burst,
  companies,
  deals,
  kindColour,
  kinds,
  LAST_DAY,
  news,
  pillClass,
  pillLabel,
  status,
  useDataset,
} from "../lib/data.ts";
import type { DatasetId } from "../lib/data.ts";
import { formatValue, totalForDate } from "../lib/layout.ts";
import {
  dayLabel,
  FIRST_DAY,
  inDateOrder,
  pillKind,
  placeLabels,
  publisherName,
  timelineScale,
} from "../lib/timeline.ts";
import { chapterProblems, chapterSources, orderChapterFiles } from "../lib/story.ts";
import type { Chapter } from "../lib/story.ts";
import { SITE_NAME } from "../lib/site.ts";

type Props = { id: DatasetId };
const { id } = Astro.props;

// The page is drawn here in its first state and then follows the visitor with explore.ts. The
// data modules hold one set at a time, so the set is chosen before anything is read from them.
useDataset(id);
const isPast = id !== "ai";
// Each bubble's tab opens its story; explicit Explore addresses still open the day-by-day view.
const STORY_ENABLED = true;
// Everything below is taken now, while this set is the active one.
const bubbleName = { ai: "AI bubble", dotcom: "Dot-com bubble", housing: "Housing bubble" }[id];
// What the browser tab calls each set, and the line a search result or link preview shows. The
// past sets' years are their meta.json first and last days.
const pageName = { ai: "AI", dotcom: "Dot-com", housing: "Housing" }[id];
const descriptions = {
  ai: "How the AI money bubble formed, day by day: company values, who paid whom, and the news behind it.",
  dotcom: "The dot-com bubble, 1995 to 2002, day by day: company values, deals and the news behind them.",
  housing: "The housing bubble, 2003 to 2009, day by day: bank values, deals and the news behind them.",
};
const pageTitle = `${pageName} | ${SITE_NAME}`;
const description = descriptions[id];
const setStatus = status;
const setKinds = kinds;
const firstDay = FIRST_DAY;
const lastDay = LAST_DAY;
const allCompanies = companies;
const allDeals = deals;
const ordered = inDateOrder(news.filter((item) => item.kind === "money" && item.date >= firstDay));
const current = ordered[isPast ? 0 : ordered.length - 1];
const pill = pillKind(current, allDeals);
const pillColour = pillClass(pill);
const pillName = pillLabel(pill);
const nameOf = new Map(allCompanies.map((company) => [company.id, company.name]));
const players = current.players.map((player) => nameOf.get(player) ?? player).join(", ");
const keyDates = ordered.filter((item) => item.key_date);
const smallDates = ordered.filter((item) => item.small_date);
const publisher = publisherName(current.source);
// One day scale for the dots, the ticks, the years and the slider, so busy months are wider.
const scale = timelineScale(lastDay, { red: keyDates, blue: smallDates });
const sliderValue = Math.round(scale.percentOf(current.date) * 100);

// The legend under the bubble: every kind the set uses, with the colour of its money line. The
// phone's version keeps the design's short names for the AI set's three kinds; a past set shows
// its own labels, which are short already.
const PHONE_LABELS: Record<string, string> = {
  investment: "Investment",
  cloud: "Cloud",
  chip: "Chips",
};
const total = formatValue(totalForDate(current.date));
const legend = setKinds.map((kind) => ({
  label: kind.label,
  phoneLabel: isPast ? kind.label : (PHONE_LABELS[kind.id] ?? kind.label),
  colour: kindColour(kind.id),
}));

// A day tick under the line: every 1 January carries its year, the quarter days carry nothing. A
// quarter tick less than 6px from the tick before it would read as one thick tick, so it is left
// out, and a year's name is left out when it would touch the name before it. Both are measured on
// a 1360px line, the widest the page draws.
const TICK_LINE_WIDTH = 1360;
const TICK_GAP = 6;
const YEAR_NAME_WIDTH = 28;
const ticks: { date: string; year: boolean; percent: number }[] = [];
let lastTick = -Infinity;
for (let year = Number(firstDay.slice(0, 4)); year <= Number(lastDay.slice(0, 4)); year += 1) {
  for (const month of ["01", "04", "07", "10"]) {
    const date = `${year}-${month}-01`;
    if (date < firstDay || date > lastDay) continue;
    const percent = scale.percentOf(date);
    const yearTick = month === "01";
    if (!yearTick && ((percent - lastTick) / 100) * TICK_LINE_WIDTH < TICK_GAP) continue;
    ticks.push({ date, year: yearTick, percent });
    lastTick = percent;
  }
}
const yearNames: { year: string; percent: number }[] = [];
let lastRight = -Infinity;
for (const tick of ticks) {
  if (!tick.year) continue;
  const middle = (tick.percent / 100) * TICK_LINE_WIDTH;
  const left = middle - YEAR_NAME_WIDTH / 2;
  if (left <= lastRight) continue;
  yearNames.push({ year: tick.date.slice(0, 4), percent: tick.percent });
  lastRight = middle + YEAR_NAME_WIDTH / 2;
}

// Alternate key dates above and below, with two heights per side to keep neighbours apart.
// The text is the item's label when it has one, else its title, at most 120px wide and two lines.
// The page draws them from this first estimate; explore.ts re-places them once the real widths
// are known.
const labels = placeLabels(
  keyDates.map((item) => ({
    id: item.id,
    percent: scale.percentOf(item.date),
    width: Math.min(120, (item.label ?? item.title).length * 6.4),
  })),
  1280,
);

// The line ends on the last day in the data, not the visitor's local date.
const monthName = new Intl.DateTimeFormat("en-GB", { month: "short", year: "numeric", timeZone: "UTC" });
const firstEnd = monthName.format(new Date(`${firstDay}T00:00:00Z`));
const lastEnd = dayLabel(lastDay);

// Story mode's chapters, read from the set's own folder (docs/story, docs/story/dotcom or
// docs/story/housing) while the site is built, in file-name order. A day that is not a day, or one
// before the set's first day, stops the build with the file name; the same checks run in
// src/lib/story.test.ts. A player or link the set's data does not have yet is skipped on the page
// and printed as a warning by that test.
const chapters: Chapter[] = STORY_ENABLED ? orderChapterFiles(chapterSources(id)) : [];
if (STORY_ENABLED) {
  const chapterProblemsFound = chapterProblems(chapters, firstDay);
  if (chapters.length === 0) throw new Error(`Story mode has no chapters for the ${bubbleName}.`);
  if (chapterProblemsFound.length > 0) {
    throw new Error(`Story chapters are not ready:\n${chapterProblemsFound.join("\n")}`);
  }
}
const firstChapter = chapters[0];
// The browser needs the chapter text too, so the page carries it as data rather than asking for
// the files again.
const chaptersJson = chapters.length > 0 ? JSON.stringify(chapters).replace(/</g, "\\u003c") : "";

// A sample set says so. Any other set carries no sentence of its own; the Report a problem link
// below shows on every set either way.
const statusLine = setStatus === "sample" ? "Sample data, for testing only." : "";
const ariaFor = (itemTitle: string, date: string) => `${dayLabel(date)}, ${itemTitle}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
  </head>
  <body data-mode="explore" data-dataset={id} data-story-enabled={STORY_ENABLED}>
    <div class="layout-desktop">
      <header class="site-header">
        <a class="wordmark" href="/">Bubble</a>
        <nav class="site-nav" aria-label="Sections">
          <a
            class:list={["nav-item", !isPast && "nav-current"]}
            href="/"
            aria-current={isPast ? undefined : "page"}>AI</a
          >
          <a
            class:list={["nav-item", id === "dotcom" && "nav-current"]}
            href="/past/dotcom/"
            aria-current={id === "dotcom" ? "page" : undefined}>Dot-com</a
          >
          <a
            class:list={["nav-item", id === "housing" && "nav-current"]}
            href="/past/housing/"
            aria-current={id === "housing" ? "page" : undefined}>Housing</a
          >
          <a class="nav-item" href="/compare/">Compare</a>
        </nav>
      </header>

      <main class="explore-main">
        <div class="story-column">
          <p class="kicker boom-kicker explore-only" data-bind="kicker-desktop">{bubbleName}</p>
          {
            STORY_ENABLED && (
              <p class="kicker story-only" data-bind="story-kicker">
                Chapter 1 of {chapters.length}
              </p>
            )
          }
          <div data-block="item">
            <h1 class="big-heading" data-bind="title">{current.title}</h1>
            <span class:list={["pill", `pill-${pillColour}`]} data-bind="pill"
              ><span class="pill-line" aria-hidden="true"></span
              ><span data-bind="pill-label">{pillName}</span></span
            >
            <p class="summary" data-bind="summary">{current.summary}</p>
            <a
              class="source"
              data-bind="source"
              href={current.source}
              target="_blank"
              rel="noopener"
              aria-label={`Source: ${publisher}, opens in a new tab`}
              >{publisher} · {dayLabel(current.date)} ↗</a
            >
            <p class="players-line" data-players-line>
              The view follows the players:{" "}
              <strong data-bind="names-desktop">{players}</strong>
            </p>
          </div>

          <div data-block="quiet" hidden>
            <p class="latest-label">Latest before this day:</p>
            <h1 class="big-heading">
              <button type="button" class="latest-button" data-action="latest" data-bind="latest-title"
                >{current.title}</button
              >
            </h1>
          </div>

          <div data-block="company" hidden>
            <h1 class="big-heading" data-bind="company-name"></h1>
            <button type="button" class="company-back" data-action="company-back">← Back</button>
            <p class="company-value" data-bind="company-value"></p>
            <p class="company-note" data-bind="company-note"></p>
            <a class="source" data-bind="company-source" target="_blank" rel="noopener"></a>
            <p class="sheet-kicker company-news-heading">News</p>
            <ul class="company-news" data-bind="company-news"></ul>
            <p class="company-news-empty" data-bind="company-news-empty" hidden
              >No news about this company up to this day.</p
            >
          </div>

          {
            STORY_ENABLED && (
              <div data-block="story" hidden>
                <h1 class="headline" data-bind="story-title" tabindex="-1">
                  {firstChapter.title}
                </h1>
                <div class="chapter-text" data-bind="story-text">
                  {firstChapter.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
                <p class="story-sources" data-story-sources hidden></p>
                <div class="button-row">
                  <button type="button" class="button" data-action="chapter-earlier">
                    ← Earlier
                  </button>
                  <button type="button" class="button button-primary" data-action="chapter-next">
                    Next chapter →
                  </button>
                </div>
                <div class="story-links">
                  <button type="button" class="read-story" data-action="story-open" aria-expanded="false">
                    Read the story
                  </button>
                  <button type="button" class="read-story" data-action="story-explore" aria-label="Explore day by day" title="Explore day by day">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="m16 8-2 6-6 2 2-6z"></path></svg>
                  </button>
                </div>
              </div>
            )
          }

          {
            STORY_ENABLED && (
              <div data-block="story-list" hidden>
                <div class="chapter-list">
                  <div class="chapter-list-head">
                    <h2 class="chapter-list-title">The story</h2>
                    <button
                      type="button"
                      class="chapter-list-close"
                      data-action="story-close"
                      aria-label="Close the story"
                    >
                      ×
                    </button>
                  </div>
                  <ol class="chapter-list-items">
                    {chapters.map((chapter) => (
                      <li>
                        <button type="button" class="chapter-row" data-chapter={chapter.number}>
                          <span class="chapter-row-kicker">
                            Chapter {chapter.number} · {dayLabel(chapter.date)}
                          </span>
                          <span class="chapter-row-title">{chapter.title}</span>
                        </button>
                      </li>
                    ))}
                  </ol>
                </div>
              </div>
            )
          }

          <div class="button-row explore-only">
            <button type="button" class="button" data-action="earlier">← Earlier</button>
            <button type="button" class="button button-primary" data-action="later">Later →</button>
          </div>
        </div>

        <div class="bubble-column">
          <div class="bubble-wrap">
            <svg class="bubble-svg" data-bubble="desktop" viewBox="0 0 100 100" role="img"></svg>
            <div class="zoom-buttons">
              <button type="button" class="zoom-button" data-zoom="fit" aria-label="Focus on the players">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h5V4M20 9h-5V4M4 15h5v5M20 15h-5v5"></path></svg>
              </button>
            </div>
          </div>
          <div class="bubble-meta">
            <div data-bind="companies">Combined value of the companies shown: {total}</div>
            {!isPast && <div>Whole-company values, so non-AI business counts too.</div>}
          </div>
          <div class="legend">
            <span class="legend-title">Money flow</span>
            {legend.map((kind) => (
              <span class="legend-item">
                <span class:list={["legend-line", `legend-${kind.colour}`]} aria-hidden="true"></span>
                {kind.label}
              </span>
            ))}
          </div>
        </div>
      </main>

      <section class="timeline" aria-label="Timeline">
        <div class="timeline-row">
        <div class="timeline-inner" data-timeline>
          <div class="timeline-axis" aria-hidden="true"></div>
          <div class="timeline-current" data-timeline-current aria-hidden="true"><span data-current-flag></span></div>
          <input
            class="day-range"
            data-slider
            type="range"
            min="0"
            max="10000"
            step="1"
            value={sliderValue}
            aria-label="Day"
            aria-valuetext={dayLabel(current.date)}
          />
          {
            keyDates.map((item) => {
              const left = scale.percentOf(item.date);
              const label = labels.get(item.id);
              const text = item.label ?? item.title;
              return (
                <>
                  <button
                    type="button"
                    class="timeline-dot"
                    data-dot="key"
                    data-news={item.id}
                    data-timeline-date={item.date}
                    style={`left: ${left}%`}
                    title={item.title}
                    aria-label={ariaFor(item.title, item.date)}
                  >
                    <span class="dot" />
                  </button>
                  <span
                    class="timeline-label"
                    data-timeline-label
                    data-timeline-date={item.date}
                    data-timeline-id={item.id}
                    data-row={label?.row}
                    data-side={label?.side}
                    data-align={label?.align ?? "center"}
                    style={`left: ${left}%; margin-left: ${label?.shift ?? 0}px`}
                    hidden={!label}
                    aria-hidden="true"
                  >
                    {text}
                  </span>
                </>
              );
            })
          }
          {
            ordered.filter((item) => !item.key_date).map((item) => (
              <>
                <button
                  type="button"
                  class="timeline-dot"
                  data-dot="small"
                   data-zoom-only={!item.small_date || undefined}
                  data-news={item.id}
                    data-timeline-date={item.date}
                  style={`left: ${scale.percentOf(item.date)}%`}
                  title={item.title}
                  aria-label={ariaFor(item.title, item.date)}
                >
                  <span class="dot" />
                </button>
                <span
                  class="timeline-label timeline-label-hover"
                  data-timeline-hover
                   data-zoom-only={!item.small_date || undefined}
                    data-timeline-date={item.date}
                    data-timeline-id={item.id}
                  data-row="0"
                  data-align="center"
                  style={`left: ${scale.percentOf(item.date)}%`}
                  aria-hidden="true"
                >
                  {item.label ?? item.title}
                </span>
              </>
            ))
          }
          {
            STORY_ENABLED &&
              chapters.map((chapter) => {
                const left = scale.percentOf(chapter.date);
                return (
                  <>
                    <button
                      type="button"
                      class="timeline-dot story-dot"
                      data-chapter={chapter.number}
                      data-timeline-date={chapter.date}
                      style={`left: ${left}%`}
                      title={chapter.title}
                      aria-label={`Chapter ${chapter.number} of ${chapters.length}: ${dayLabel(chapter.date)}, ${chapter.title}`}
                    >
                      <span class="dot" />
                    </button>
                    <span
                      class="timeline-label"
                      data-story-label
                      data-timeline-date={chapter.date}
                      style={`left: ${left}%`}
                      hidden
                      aria-hidden="true"
                    >
                      {chapter.title}
                    </span>
                  </>
                );
              })
          }
          {
            ticks.map((tick) => (
              <span
                class:list={["timeline-tick", `timeline-tick-${tick.year ? "year" : "quarter"}`]}
                data-timeline-date={tick.date}
                style={`left: ${tick.percent}%`}
                aria-hidden="true"
              />
            ))
          }
          {
            burst && (
              <span
                class="timeline-burst"
                data-timeline-date={burst.date}
                style={`left: ${scale.percentOf(burst.date)}%`}
                aria-hidden="true"
              />
            )
          }
          {
            yearNames.map((name) => (
              <span class="timeline-year" data-timeline-date={`${name.year}-01-01`} style={`left: ${name.percent}%`} aria-hidden="true">
                {name.year}
              </span>
            ))
          }
          <div class="timeline-ends" aria-hidden="true"><span>{firstEnd}</span><span>{lastEnd}</span></div>
        </div>

        </div>
        <div class="timeline-footer">
          <div class="timeline-summary">
            <div class="timeline-strip" data-timeline-strip>
              <div class="timeline-strip-line" aria-hidden="true"></div>
              <div class="timeline-strip-dots" data-strip-dots aria-hidden="true"></div>
              <div class="timeline-strip-bracket" data-strip-bracket aria-hidden="true"></div>
              <div class="timeline-strip-current" data-strip-current aria-hidden="true"></div>
              <input type="range" min="0" max="10000" step="1" value="10000" data-strip-slider aria-label="Position in the whole timeline" />
              <div class="timeline-strip-ends" aria-hidden="true"><span>{firstEnd}</span><span>{lastEnd}</span></div>
            </div>
            <span data-timeline-summary></span>
          </div>
          <div class="timeline-controls">
            {STORY_ENABLED && (
              <button type="button" data-action="timeline-story" aria-label="Back to the story" title="Back to the story">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 6v14m0-14c-3-2-6-2-10-2v14c4 0 7 0 10 2 3-2 6-2 10-2V4c-4 0-7 0-10 2z"></path></svg>
              </button>
            )}
            <button type="button" data-action="timeline-start" aria-label="First day" title="First day">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.3-5.6M4 4v4h4"></path></svg>
            </button>
            <button type="button" data-action="timeline-zoom" aria-pressed="true" aria-label="Whole timeline" title="Whole timeline">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg>
            </button>
            <button type="button" data-timeline-earlier data-action="earlier" aria-label="Earlier" title="Earlier">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 12H4m7-7-7 7 7 7"></path></svg>
            </button>
            <button type="button" data-timeline-next data-action="later" aria-label="Later" title="Later">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12h16m-7-7 7 7-7 7"></path></svg>
            </button>
          </div>
        </div>
        <p class="status desktop-timeline-status">{statusLine && `${statusLine} `}<a href="https://github.com/Rathtakrit/aibubble/issues/new/choose">Report a problem</a></p>
      </section>
    </div>

    <div class="layout-phone">
      <div class="map-bubble">
        <svg class="bubble-svg" data-bubble="phone" viewBox="0 0 100 100" role="img"></svg>
      </div>

      <div class="map-top">
        <span class="wordmark-chip">Bubble</span>
      </div>

      <div class="map-side">
        <div class="legend phone-legend" aria-label="Money flow">
          {legend.map((kind) => (
            <span class="legend-item">
              <span class:list={["legend-line", `legend-${kind.colour}`]} aria-hidden="true"></span>
              {kind.phoneLabel}
            </span>
          ))}
        </div>

        <div class="zoom-buttons map-zoom">
          <button type="button" class="zoom-button" data-zoom="fit" aria-label="Focus on the players">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h5V4M20 9h-5V4M4 15h5v5M20 15h-5v5"></path></svg>
          </button>
        </div>
      </div>

      <section class="sheet" aria-label="News item" data-sheet>
        <button
          type="button"
          class="sheet-handle"
          data-sheet-handle
          aria-expanded="true"
          aria-label="Show less"
        >
          <span class="grabber" aria-hidden="true"></span>
        </button>
        <nav class="mode-switch" aria-label="Bubbles">
          <a
            class:list={["mode-button", !isPast && "nav-current"]}
            href="/"
            aria-current={isPast ? undefined : "page"}>AI</a
          >
          <a
            class:list={["mode-button", id === "dotcom" && "nav-current"]}
            href="/past/dotcom/"
            aria-current={id === "dotcom" ? "page" : undefined}>Dot-com</a
          >
          <a
            class:list={["mode-button", id === "housing" && "nav-current"]}
            href="/past/housing/"
            aria-current={id === "housing" ? "page" : undefined}>Housing</a
          >
          <a class="mode-button" href="/compare/">Compare</a>
        </nav>
        <div class="dock-row">
          <p class="dock-title" data-bind="dock-title">{current.title}</p>
        </div>

        <p class="sheet-kicker boom-kicker explore-only" data-bind="kicker-phone">{bubbleName}</p>

        <div data-block="item">
          <h1 class="sheet-title" data-bind="title">{current.title}</h1>
          <p class="summary" data-bind="summary">{current.summary}</p>
          <a
            class="source"
            data-bind="source"
            href={current.source}
            target="_blank"
            rel="noopener"
            aria-label={`Source: ${publisher}, opens in a new tab`}
            >{publisher} · {dayLabel(current.date)} ↗</a
          >
        </div>

        <div data-block="quiet" hidden>
          <p class="latest-label">Latest before this day:</p>
          <button type="button" class="latest-button" data-action="latest" data-bind="latest-title"
            >{current.title}</button
          >
        </div>

        <div data-block="company" hidden>
          <button type="button" class="company-back" data-action="company-back">← Back</button>
          <h1 class="sheet-title" data-bind="company-name"></h1>
          <p class="company-value" data-bind="company-value"></p>
          <p class="company-note" data-bind="company-note"></p>
          <a class="source" data-bind="company-source" target="_blank" rel="noopener"></a>
          <p class="sheet-kicker company-news-heading">News</p>
          <ul class="company-news" data-bind="company-news"></ul>
          <p class="company-news-empty" data-bind="company-news-empty" hidden
            >No news about this company up to this day.</p
          >
        </div>

        {
          STORY_ENABLED && (
            <div data-block="story" hidden>
              <p class="sheet-kicker" data-bind="story-kicker">
                Chapter 1 of {chapters.length}
              </p>
              <h1 class="sheet-title" data-bind="story-title" tabindex="-1">
                {firstChapter.title}
              </h1>
              <div class="chapter-text" data-bind="story-text">
                {firstChapter.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
              <p class="story-sources" data-story-sources hidden></p>
              <div class="story-links">
                <button type="button" class="read-story" data-action="story-open" aria-expanded="false">
                  Read the story
                </button>
                <button type="button" class="read-story" data-action="story-explore" aria-label="Explore day by day" title="Explore day by day">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="m16 8-2 6-6 2 2-6z"></path></svg>
                </button>
              </div>
            </div>
          )
        }

        {
          STORY_ENABLED && (
            <div data-block="story-list" hidden>
              <div class="chapter-list chapter-list-sheet">
                <div class="chapter-list-head">
                  <h2 class="chapter-list-title">The story</h2>
                  <button
                    type="button"
                    class="chapter-list-close"
                    data-action="story-close"
                    aria-label="Close the story"
                  >
                    ×
                  </button>
                </div>
                <ol class="chapter-list-items">
                  {chapters.map((chapter) => (
                    <li>
                      <button type="button" class="chapter-row" data-chapter={chapter.number}>
                        <span class="chapter-row-kicker">
                          Chapter {chapter.number} · {dayLabel(chapter.date)}
                        </span>
                        <span class="chapter-row-title">{chapter.title}</span>
                      </button>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
          )
        }

        <p class="status">{statusLine && `${statusLine} `}<a href="https://github.com/Rathtakrit/aibubble/issues/new/choose">Report a problem</a></p>
      </section>
    </div>

    {STORY_ENABLED && <script type="application/json" data-story-chapters set:html={chaptersJson}></script>}
    <script>
      import "../scripts/explore.ts";
    </script>
  </body>
</html>
