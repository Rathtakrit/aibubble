---
import "@fontsource/instrument-serif/400.css";
import "@fontsource-variable/instrument-sans/index.css";
import "../styles/tokens.css";
import "../styles/explore.css";
import {
  companies,
  datasetTitle,
  deals,
  kindColour,
  kinds,
  LAST_DAY,
  news,
  pillClass,
  pillLabel,
  status,
  useDataset,
} from "../lib/data.ts";
import type { DatasetId } from "../lib/data.ts";
import { formatValue, totalForDate } from "../lib/layout.ts";
import {
  dayLabel,
  FIRST_DAY,
  inDateOrder,
  pillKind,
  placeLabels,
  publisherName,
  timelineScale,
} from "../lib/timeline.ts";
import { chapterProblems, chapterSources, orderChapterFiles } from "../lib/story.ts";

type Props = { id: DatasetId };
const { id } = Astro.props;

// The page is drawn here in its first state and then follows the visitor with explore.ts. The
// data modules hold one set at a time, so the set is chosen before anything is read from them.
useDataset(id);
const isPast = id !== "ai";
// Story is off for now because it is too close to Explore.
const STORY_ENABLED = false;
// Everything below is taken now, while this set is the active one.
const title = datasetTitle;
const setStatus = status;
const setKinds = kinds;
const firstDay = FIRST_DAY;
const lastDay = LAST_DAY;
const allCompanies = companies;
const allDeals = deals;
const ordered = inDateOrder(news.filter((item) => item.kind === "money" && item.date >= firstDay));
const current = ordered[ordered.length - 1];
const count = ordered.length;
const position = count;
const pill = pillKind(current, allDeals);
const pillColour = pillClass(pill);
const pillName = pillLabel(pill);
const nameOf = new Map(allCompanies.map((company) => [company.id, company.name]));
const players = current.players.map((player) => nameOf.get(player) ?? player).join(", ");
const keyDates = ordered.filter((item) => item.key_date);
const smallDates = ordered.filter((item) => item.small_date);
const place = new Map(ordered.map((item, index) => [item.id, index + 1]));
const publisher = publisherName(current.source);
// One day scale for the dots, the ticks, the years and the slider, so busy months are wider.
const scale = timelineScale(lastDay, { red: keyDates, blue: smallDates });
const sliderValue = Math.round(scale.percentOf(current.date) * 100);

// The legend under the bubble: every kind the set uses, with the colour of its money line. The
// phone's version keeps the design's short names for the AI set's three kinds; a past set shows
// its own labels, which are short already.
const PHONE_LABELS: Record<string, string> = {
  investment: "Investment",
  cloud: "Cloud",
  chip: "Chips",
};
const total = formatValue(totalForDate(current.date));
const legend = setKinds.map((kind) => ({
  label: kind.label,
  phoneLabel: isPast ? kind.label : (PHONE_LABELS[kind.id] ?? kind.label),
  colour: kindColour(kind.id),
}));

// A day tick under the line: every 1 January carries its year, the quarter days carry nothing. A
// quarter tick less than 6px from the tick before it would read as one thick tick, so it is left
// out, and a year's name is left out when it would touch the name before it. Both are measured on
// a 1360px line, the widest the page draws.
const TICK_LINE_WIDTH = 1360;
const TICK_GAP = 6;
const YEAR_NAME_WIDTH = 28;
const ticks: { date: string; year: boolean; percent: number }[] = [];
let lastTick = -Infinity;
for (let year = Number(firstDay.slice(0, 4)); year <= Number(lastDay.slice(0, 4)); year += 1) {
  for (const month of ["01", "04", "07", "10"]) {
    const date = `${year}-${month}-01`;
    if (date < firstDay || date > lastDay) continue;
    const percent = scale.percentOf(date);
    const yearTick = month === "01";
    if (!yearTick && ((percent - lastTick) / 100) * TICK_LINE_WIDTH < TICK_GAP) continue;
    ticks.push({ date, year: yearTick, percent });
    lastTick = percent;
  }
}
const yearNames: { year: string; percent: number }[] = [];
let lastRight = -Infinity;
for (const tick of ticks) {
  if (!tick.year) continue;
  const middle = (tick.percent / 100) * TICK_LINE_WIDTH;
  const left = middle - YEAR_NAME_WIDTH / 2;
  if (left <= lastRight) continue;
  yearNames.push({ year: tick.date.slice(0, 4), percent: tick.percent });
  lastRight = middle + YEAR_NAME_WIDTH / 2;
}

// Alternate key dates above and below, with two heights per side to keep neighbours apart.
// The text is the item's label when it has one, else its title, at most 120px wide and two lines.
// The page draws them from this first estimate; explore.ts re-places them once the real widths
// are known.
const labels = placeLabels(
  keyDates.map((item) => ({
    id: item.id,
    percent: scale.percentOf(item.date),
    width: Math.min(120, (item.label ?? item.title).length * 6.4),
  })),
  1280,
);

// The line runs from the set's first month to its last; only the AI page ends on "Today".
const monthYear = new Intl.DateTimeFormat("en-GB", { month: "short", year: "numeric", timeZone: "UTC" });
const firstEnd = monthYear.format(new Date(`${firstDay}T00:00:00Z`));
const lastEnd = isPast ? monthYear.format(new Date(`${lastDay}T00:00:00Z`)) : "Today";

// Story mode's chapters, read from docs/story while the site is built, in file-name order. A day
// before the site starts, or a company the data does not have, stops the build with the file
// name. A past page has no Story mode, so it reads none.
const chapters = isPast ? [] : orderChapterFiles(chapterSources());
if (!isPast) {
  const chapterProblemsFound = chapterProblems(
    chapters,
    allCompanies.map((company) => company.id),
  );
  if (chapters.length === 0) throw new Error("Story mode has no chapters: docs/story has no .md files.");
  if (chapterProblemsFound.length > 0) {
    throw new Error(`Story chapters are not ready:\n${chapterProblemsFound.join("\n")}`);
  }
}
const firstChapter = chapters[0];
const firstChapterNames = firstChapter
  ? firstChapter.players.map((company) => nameOf.get(company) ?? company).join(", ")
  : "";
// The browser needs the chapter text too, so the page carries it as data rather than asking for
// the files again.
const chaptersJson = isPast ? "" : JSON.stringify(chapters).replace(/</g, "\\u003c");

const statusLine =
  setStatus === "sample"
    ? "Sample data, for testing only."
    : setStatus === "draft"
      ? "Draft data: researched, not yet checked by the owner."
      : "";
const ariaFor = (id: string, itemTitle: string, date: string) =>
  `News ${place.get(id)} of ${count}: ${dayLabel(date)}, ${itemTitle}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AI Bubble</title>
  </head>
  <body data-mode="explore" data-dataset={id} data-story-enabled={isPast ? undefined : STORY_ENABLED}>
    <div class="layout-desktop">
      <header class="site-header">
        <a class="wordmark" href="/">AI Bubble</a>
        <nav class="site-nav" aria-label="Sections">
          {STORY_ENABLED && <a class="nav-item" data-mode="story" href="/?chapter=1">Story</a>}
          <a
            class:list={["nav-item", !isPast && "nav-current"]}
            data-mode={isPast ? undefined : "explore"}
            href="/"
            aria-current={isPast ? undefined : "page"}>Explore</a
          >
          <span class="nav-item">Science<span class="nav-tag">soon</span></span>
          <span class="nav-item">News<span class="nav-tag">soon</span></span>
          <a
            class:list={["nav-item", isPast && "nav-current"]}
            href="/past/dotcom/"
            aria-current={isPast ? "page" : undefined}>Past bubbles</a
          >
        </nav>
      </header>

      <main class="explore-main">
        <div class="story-column">
          <p class="kicker explore-only" data-bind="kicker-desktop">{title} · news {position} of {count}</p>
          {
            STORY_ENABLED && !isPast && (
              <p class="kicker story-only" data-bind="story-kicker">
                Chapter 1 of {chapters.length}
              </p>
            )
          }
          {
            isPast && (
              <div class="mode-switch past-switch" role="group" aria-label="Past bubble">
                <a
                  class:list={["mode-button", id === "dotcom" && "nav-current"]}
                  href="/past/dotcom/"
                  aria-current={id === "dotcom" ? "page" : undefined}
                >
                  Dot-com, 1995 to 2002
                </a>
                <a
                  class:list={["mode-button", id === "housing" && "nav-current"]}
                  href="/past/housing/"
                  aria-current={id === "housing" ? "page" : undefined}
                >
                  Housing, 2003 to 2009
                </a>
              </div>
            )
          }
          <p class="big-date" data-bind="date">{dayLabel(current.date)}</p>

          <div data-block="item">
            <span class:list={["pill", `pill-${pillColour}`]} data-bind="pill"
              ><span class="pill-line" aria-hidden="true"></span
              ><span data-bind="pill-label">{pillName}</span></span
            >
            <h1 class="headline" data-bind="title">{current.title}</h1>
            <p class="summary" data-bind="summary">{current.summary}</p>
            <a
              class="source"
              data-bind="source"
              href={current.source}
              target="_blank"
              rel="noopener"
              aria-label={`Source: ${publisher}, opens in a new tab`}
              >{publisher} · {dayLabel(current.date)} ↗</a
            >
            <p class="players-line" data-players-line>
              The view follows the players:{" "}
              <strong data-bind="names-desktop">{players}</strong>
            </p>
          </div>

          <div data-block="quiet" hidden>
            <p class="latest-label">Latest before this day:</p>
            <button type="button" class="latest-button" data-action="latest" data-bind="latest-title"
              >{current.title}</button
            >
          </div>

          <div data-block="company" hidden>
            <button type="button" class="company-back" data-action="company-back">← Back</button>
            <h1 class="headline" data-bind="company-name"></h1>
            <p class="company-value" data-bind="company-value"></p>
            <p class="company-note" data-bind="company-note"></p>
            <a class="source" data-bind="company-source" target="_blank" rel="noopener"></a>
            <p class="sheet-kicker company-news-heading">News</p>
            <ul class="company-news" data-bind="company-news"></ul>
            <p class="company-news-empty" data-bind="company-news-empty" hidden
              >No news about this company up to this day.</p
            >
          </div>

          {
            STORY_ENABLED && !isPast && (
              <div data-block="story" hidden>
                <h1 class="headline" data-bind="story-title" tabindex="-1">
                  {firstChapter.title}
                </h1>
                <div class="chapter-text" data-bind="story-text" tabindex="0">
                  {firstChapter.paragraphs.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
                <p class="status">Sample chapters, written by AI, not yet rewritten by the owner.</p>
                <p class="players-line" data-players-line="story">
                  The view follows the players:{" "}
                  <strong data-bind="story-names">{firstChapterNames}</strong>
                </p>
                <div class="button-row">
                  <button type="button" class="button" data-action="chapter-earlier">
                    ← Earlier
                  </button>
                  <button type="button" class="button button-primary" data-action="chapter-next">
                    Next chapter →
                  </button>
                </div>
                <button type="button" class="read-story" data-action="story-open" aria-expanded="false">
                  Read the story
                </button>
              </div>
            )
          }

          {
            STORY_ENABLED && !isPast && (
              <div data-block="story-list" hidden>
                <div class="chapter-list">
                  <div class="chapter-list-head">
                    <h2 class="chapter-list-title">The story</h2>
                    <button
                      type="button"
                      class="chapter-list-close"
                      data-action="story-close"
                      aria-label="Close the story"
                    >
                      ×
                    </button>
                  </div>
                  <ol class="chapter-list-items">
                    {chapters.map((chapter) => (
                      <li>
                        <button type="button" class="chapter-row" data-chapter={chapter.number}>
                          <span class="chapter-row-kicker">
                            Chapter {chapter.number} · {dayLabel(chapter.date)}
                          </span>
                          <span class="chapter-row-title">{chapter.title}</span>
                        </button>
                      </li>
                    ))}
                  </ol>
                </div>
              </div>
            )
          }

          <div class="button-row explore-only">
            <button type="button" class="button" data-action="earlier">← Earlier</button>
            <button type="button" class="button button-primary" data-action="later">Later →</button>
          </div>
        </div>

        <div class="bubble-column">
          <div class="bubble-wrap">
            <svg class="bubble-svg" data-bubble="desktop" viewBox="0 0 100 100" role="img"></svg>
            <div class="zoom-buttons">
              <button type="button" class="zoom-button" data-zoom="in" aria-label="Zoom in">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5v14"></path></svg>
              </button>
              <button type="button" class="zoom-button" data-zoom="out" aria-label="Zoom out">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"></path></svg>
              </button>
              <button type="button" class="zoom-button" data-zoom="fit" aria-label="Fit the view to the players">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg>
              </button>
            </div>
          </div>
          <div class="bubble-meta">
            <span data-bind="companies"
              >{isPast ? "All companies shown" : "All AI companies"} on {dayLabel(current.date)} · total {total}</span
            >
          </div>
          <div class="legend">
            <span class="legend-title">Money flow</span>
            {legend.map((kind) => (
              <span class="legend-item">
                <span class:list={["legend-line", `legend-${kind.colour}`]} aria-hidden="true"></span>
                {kind.label}
              </span>
            ))}
          </div>
        </div>
      </main>

      <section class="timeline" aria-label="Timeline">
        <div class="timeline-inner" data-timeline>
          <div class="timeline-axis" aria-hidden="true"></div>
          <input
            class="day-range"
            data-slider
            type="range"
            min="0"
            max="10000"
            step="1"
            value={sliderValue}
            aria-label="Day"
            aria-valuetext={dayLabel(current.date)}
          />
          {
            keyDates.map((item) => {
              const left = scale.percentOf(item.date);
              const label = labels.get(item.id);
              const text = item.label ?? item.title;
              return (
                <>
                  <button
                    type="button"
                    class="timeline-dot"
                    data-dot="key"
                    data-news={item.id}
                    style={`left: ${left}%`}
                    title={item.title}
                    aria-label={ariaFor(item.id, item.title, item.date)}
                  >
                    <span class="dot" />
                  </button>
                  <span
                    class="timeline-label"
                    data-timeline-label
                    data-row={label?.row}
                    data-side={label?.side}
                    data-align={label?.align ?? "center"}
                    style={`left: ${left}%; margin-left: ${label?.shift ?? 0}px`}
                    hidden={!label}
                    aria-hidden="true"
                  >
                    {text}
                  </span>
                </>
              );
            })
          }
          {
            smallDates.map((item) => (
              <>
                <button
                  type="button"
                  class="timeline-dot"
                  data-dot="small"
                  data-news={item.id}
                  style={`left: ${scale.percentOf(item.date)}%`}
                  title={item.title}
                  aria-label={ariaFor(item.id, item.title, item.date)}
                >
                  <span class="dot" />
                </button>
                <span
                  class="timeline-label timeline-label-hover"
                  data-timeline-hover
                  data-row="0"
                  data-align="center"
                  style={`left: ${scale.percentOf(item.date)}%`}
                  aria-hidden="true"
                >
                  {item.label ?? item.title}
                </span>
              </>
            ))
          }
          {
            STORY_ENABLED && !isPast &&
              chapters.map((chapter) => {
                const left = scale.percentOf(chapter.date);
                return (
                  <>
                    <button
                      type="button"
                      class="timeline-dot story-dot"
                      data-chapter={chapter.number}
                      style={`left: ${left}%`}
                      title={chapter.title}
                      aria-label={`Chapter ${chapter.number} of ${chapters.length}: ${dayLabel(chapter.date)}, ${chapter.title}`}
                    >
                      <span class="dot" />
                    </button>
                    <span
                      class="timeline-label"
                      data-story-label
                      style={`left: ${left}%`}
                      hidden
                      aria-hidden="true"
                    >
                      {chapter.title}
                    </span>
                  </>
                );
              })
          }
          {
            ticks.map((tick) => (
              <span
                class:list={["timeline-tick", `timeline-tick-${tick.year ? "year" : "quarter"}`]}
                style={`left: ${tick.percent}%`}
                aria-hidden="true"
              />
            ))
          }
          {
            yearNames.map((name) => (
              <span class="timeline-year" style={`left: ${name.percent}%`} aria-hidden="true">
                {name.year}
              </span>
            ))
          }
          <div class="timeline-ends" aria-hidden="true"><span>{firstEnd}</span><span>{lastEnd}</span></div>
        </div>

        {statusLine && <p class="status">{statusLine}</p>}
      </section>
    </div>

    <div class="layout-phone">
      <div class="map-bubble">
        <svg class="bubble-svg" data-bubble="phone" viewBox="0 0 100 100" role="img"></svg>
      </div>

      <div class="map-top">
        <span class="wordmark-chip">AI Bubble</span>
      </div>

      <div class="zoom-buttons map-zoom">
        <button type="button" class="zoom-button" data-zoom="in" aria-label="Zoom in">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5v14"></path></svg>
        </button>
        <button type="button" class="zoom-button" data-zoom="out" aria-label="Zoom out">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14"></path></svg>
        </button>
        <button type="button" class="zoom-button" data-zoom="fit" aria-label="Fit the view to the players">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg>
        </button>
      </div>

      <section class="sheet" aria-label="News item" data-sheet>
        <div class="grabber" aria-hidden="true"></div>
        {
          STORY_ENABLED && !isPast && (
            <div class="mode-switch" role="group" aria-label="Mode">
              <a class="mode-button" data-mode="story" href="/?chapter=1">
                Story
              </a>
              <a class="mode-button nav-current" data-mode="explore" href="/" aria-current="page">
                Explore
              </a>
            </div>
          )
        }
        {
          isPast && (
            <div class="mode-switch past-switch" role="group" aria-label="Past bubble">
              <a
                class:list={["mode-button", id === "dotcom" && "nav-current"]}
                href="/past/dotcom/"
                aria-current={id === "dotcom" ? "page" : undefined}
              >
                Dot-com, 1995 to 2002
              </a>
              <a
                class:list={["mode-button", id === "housing" && "nav-current"]}
                href="/past/housing/"
                aria-current={id === "housing" ? "page" : undefined}
              >
                Housing, 2003 to 2009
              </a>
            </div>
          )
        }
        <p class="sheet-kicker explore-only" data-bind="kicker-phone">
          News {position} of {count} · {dayLabel(current.date)}
        </p>

        <div data-block="item">
          <h1 class="sheet-title" data-bind="title">{current.title}</h1>
          <p class="summary" data-bind="summary">{current.summary}</p>
          <a
            class="source"
            data-bind="source"
            href={current.source}
            target="_blank"
            rel="noopener"
            aria-label={`Source: ${publisher}, opens in a new tab`}
            >{publisher} · {dayLabel(current.date)} ↗</a
          >
          <div class="pill-row">
            <span class:list={["pill", `pill-${pillColour}`]} data-bind="pill"
              ><span class="pill-line" aria-hidden="true"></span
              ><span data-bind="pill-label">{pillName}</span></span
            >
            <span class="players-line" data-players-line>
              Players: <strong data-bind="names-phone">{players}</strong>
            </span>
          </div>
        </div>

        <div data-block="quiet" hidden>
          <p class="latest-label">Latest before this day:</p>
          <button type="button" class="latest-button" data-action="latest" data-bind="latest-title"
            >{current.title}</button
          >
        </div>

        <div data-block="company" hidden>
          <button type="button" class="company-back" data-action="company-back">← Back</button>
          <h1 class="sheet-title" data-bind="company-name"></h1>
          <p class="company-value" data-bind="company-value"></p>
          <p class="company-note" data-bind="company-note"></p>
          <a class="source" data-bind="company-source" target="_blank" rel="noopener"></a>
          <p class="sheet-kicker company-news-heading">News</p>
          <ul class="company-news" data-bind="company-news"></ul>
          <p class="company-news-empty" data-bind="company-news-empty" hidden
            >No news about this company up to this day.</p
          >
        </div>

        {
          STORY_ENABLED && !isPast && (
            <div data-block="story" hidden>
              <p class="sheet-kicker" data-bind="story-kicker">
                Chapter 1 of {chapters.length}
              </p>
              <h1 class="sheet-title" data-bind="story-title" tabindex="-1">
                {firstChapter.title}
              </h1>
              <div class="chapter-text" data-bind="story-text" tabindex="0">
                {firstChapter.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
              <p class="status">Sample chapters, written by AI, not yet rewritten by the owner.</p>
              <p class="players-line" data-players-line="story">
                The view follows the players: <strong data-bind="story-names">{firstChapterNames}</strong>
              </p>
              <div class="sheet-buttons">
                <button type="button" class="button" data-action="chapter-earlier">
                  ← Earlier
                </button>
                <button type="button" class="button button-primary" data-action="chapter-next">
                  Next chapter →
                </button>
              </div>
              <button type="button" class="read-story" data-action="story-open" aria-expanded="false">
                Read the story
              </button>
            </div>
          )
        }

        {
          STORY_ENABLED && !isPast && (
            <div data-block="story-list" hidden>
              <div class="chapter-list chapter-list-sheet">
                <div class="chapter-list-head">
                  <h2 class="chapter-list-title">The story</h2>
                  <button
                    type="button"
                    class="chapter-list-close"
                    data-action="story-close"
                    aria-label="Close the story"
                  >
                    ×
                  </button>
                </div>
                <ol class="chapter-list-items">
                  {chapters.map((chapter) => (
                    <li>
                      <button type="button" class="chapter-row" data-chapter={chapter.number}>
                        <span class="chapter-row-kicker">
                          Chapter {chapter.number} · {dayLabel(chapter.date)}
                        </span>
                        <span class="chapter-row-title">{chapter.title}</span>
                      </button>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
          )
        }

        <div class="legend">
          {legend.map((kind) => (
            <span class="legend-item">
              <span class:list={["legend-line", `legend-${kind.colour}`]} aria-hidden="true"></span>
              {kind.phoneLabel}
            </span>
          ))}
        </div>

        <div class="sheet-timeline">
          <div class="timeline-axis" aria-hidden="true"></div>
          <input
            class="day-range"
            data-slider
            type="range"
            min="0"
            max="10000"
            step="1"
            value={sliderValue}
            aria-label="Day"
            aria-valuetext={dayLabel(current.date)}
          />
          {
            keyDates.map((item) => (
              <button
                type="button"
                class="timeline-dot"
                data-dot="key"
                data-news={item.id}
                style={`left: ${scale.percentOf(item.date)}%`}
                title={item.title}
                aria-label={ariaFor(item.id, item.title, item.date)}
              >
                <span class="dot" />
              </button>
            ))
          }
          {
            smallDates.map((item) => (
              <button
                type="button"
                class="timeline-dot"
                data-dot="small"
                data-news={item.id}
                style={`left: ${scale.percentOf(item.date)}%`}
                title={item.title}
                aria-label={ariaFor(item.id, item.title, item.date)}
              >
                <span class="dot" />
              </button>
            ))
          }
          {
            STORY_ENABLED && !isPast &&
              chapters.map((chapter) => (
                <button
                  type="button"
                  class="timeline-dot story-dot"
                  data-chapter={chapter.number}
                  style={`left: ${scale.percentOf(chapter.date)}%`}
                  title={chapter.title}
                  aria-label={`Chapter ${chapter.number} of ${chapters.length}: ${dayLabel(chapter.date)}, ${chapter.title}`}
                >
                  <span class="dot" />
                </button>
              ))
          }
        </div>
        <div class="timeline-ends" aria-hidden="true"><span>{firstEnd}</span><span>{lastEnd}</span></div>

        <div class="sheet-buttons explore-only">
          <button type="button" class="button" data-action="earlier">← Earlier</button>
          <button type="button" class="button button-primary" data-action="later">Later →</button>
        </div>

        {statusLine && <p class="status">{statusLine}</p>}
      </section>
    </div>

    {STORY_ENABLED && !isPast && <script type="application/json" data-story-chapters set:html={chaptersJson}></script>}
    <script>
      import "../scripts/explore.ts";
    </script>
  </body>
</html>
